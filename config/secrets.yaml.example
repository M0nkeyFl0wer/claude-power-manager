# Claude Code Power Manager - Secrets Configuration
# COPY THIS TO secrets.yaml AND ADD YOUR ACTUAL CREDENTIALS
# secrets.yaml is in .gitignore - NEVER commit it to git!

# Email Notifications (optional)
email:
  enabled: false
  smtp_host: "smtp.gmail.com"
  smtp_port: 587
  smtp_user: "your-email@gmail.com"
  smtp_password: "your-app-specific-password"
  from_email: "your-email@gmail.com"
  to_email: "your-notification-email@gmail.com"

# API Keys (if integrating with monitoring services)
monitoring:
  # Grafana Cloud / Prometheus
  grafana_api_key: ""
  prometheus_endpoint: ""

  # DataDog / New Relic
  datadog_api_key: ""
  newrelic_api_key: ""

# Webhook URLs (for Slack, Discord, etc.)
webhooks:
  slack_webhook: ""
  discord_webhook: ""
  custom_webhook: ""

# SSH/Remote Management (if needed)
remote:
  ssh_private_key_path: ""
  remote_hosts: []

# Cloud Integration (if syncing logs/metrics)
cloud:
  aws_access_key: ""
  aws_secret_key: ""
  s3_bucket: ""

  gcp_project_id: ""
  gcp_credentials_path: ""

# Custom Secrets
custom:
  # Add any custom secrets your integrations need
  api_token: ""